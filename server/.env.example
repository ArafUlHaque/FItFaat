# Copy this file to server/.env and fill in your own values.
# Never commit server/.env.

NODE_ENV=development

# Assignment 03: use the last four digits of your student ID.
PORT=5000

# Shared MongoDB Atlas cluster. Ask Araf for your own database user.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@fitfaat-cluster.hc341pm.mongodb.net/fitfaat_dev?retryWrites=true&w=majority&appName=fitfaat-cluster

# Any long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Frontend address allowed by CORS (Vite's default port).
CLIENT_ORIGIN=http://localhost:5173

# Optional. Only if the server fails with "querySrv ECONNREFUSED":
# DNS_SERVERS=8.8.8.8,1.1.1.1
